<?xml version="1.0" encoding="UTF-8"?>

<owo-ui
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/26.1/owo-ui.xsd">

    <components>

        <!-- ====================================================== -->
        <!-- ROOT                                                    -->
        <!-- ====================================================== -->

        <flow-layout
            id="screen"
            direction="vertical">

            <children>

                <!-- ================================================== -->
                <!-- MAIN AREA                                          -->
                <!-- ================================================== -->

                <flow-layout
                    id="main-area"
                    direction="horizontal">

                    <children>

                        <!-- ========================================== -->
                        <!-- SIDEBAR                                    -->
                        <!-- ========================================== -->

                        <flow-layout
                            id="category-bar"
                            direction="vertical">

                            <children>

                                <!-- Sidebar header -->

                                <label id="category-title">
                                    <text>PuppyUtils</text>
                                </label>

                                <label id="category-subtitle">
                                    <text>Settings</text>
                                </label>


                                <!-- ================================== -->
                                <!-- Category buttons                   -->
                                <!-- ================================== -->

                                <button id="category-general">
                                    <text>General</text>
                                </button>

                                <button id="category-mining">
                                    <text>Mining</text>
                                </button>

                                <button id="category-farming">
                                    <text>Farming</text>
                                </button>

                                <button id="category-combat">
                                    <text>Combat</text>
                                </button>

                                <button id="category-rendering">
                                    <text>Rendering</text>
                                </button>

                            </children>


                            <!-- Space between category controls -->

                            <gap>6</gap>


                            <!-- Sidebar padding -->

                            <padding>
                                <top>16</top>
                                <bottom>16</bottom>
                                <left>12</left>
                                <right>12</right>
                            </padding>


                            <!-- Sidebar background -->

                            <surface>
                                <panel dark="true"/>
                            </surface>


                            <!-- IMPORTANT:
                                 Fixed width means changing the text
                                 or button size cannot resize the
                                 content area. -->

                            <sizing>
                                <horizontal method="fixed">160</horizontal>
                                <vertical method="fill">100</vertical>
                            </sizing>

                        </flow-layout>


                        <!-- ========================================== -->
                        <!-- CONTENT AREA                               -->
                        <!-- ========================================== -->

                        <flow-layout
                            id="content-area"
                            direction="vertical">

                            <children>

                                <!-- ================================== -->
                                <!-- HEADER                              -->
                                <!-- ================================== -->

                                <flow-layout
                                    id="content-header"
                                    direction="vertical">

                                    <children>

                                        <label id="content-title">
                                            <text>General</text>
                                        </label>

                                        <label id="content-description">
                                            <text>General PuppyUtils settings.</text>
                                        </label>

                                    </children>

                                    <gap>4</gap>

                                    <padding>
                                        <bottom>12</bottom>
                                    </padding>

                                </flow-layout>


                                <!-- ================================== -->
                                <!-- OPTIONS                             -->
                                <!-- ================================== -->

                                <!--
                                    Java dynamically inserts the
                                    modern toggles, sliders and
                                    buttons into this container.

                                    Fill sizing ensures the controls
                                    occupy the content area rather
                                    than changing the sidebar width.
                                -->

                                <flow-layout
                                    id="options"
                                    direction="vertical">

                                    <children>
                                    </children>

                                    <gap>8</gap>

                                    <padding>
                                        <top>2</top>
                                        <bottom>2</bottom>
                                        <left>0</left>
                                        <right>0</right>
                                    </padding>

                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                        <vertical method="fill">100</vertical>
                                    </sizing>

                                </flow-layout>

                            </children>


                            <gap>8</gap>


                            <padding>
                                <top>20</top>
                                <bottom>16</bottom>
                                <left>20</left>
                                <right>20</right>
                            </padding>


                            <sizing>
                                <horizontal method="fill">100</horizontal>
                                <vertical method="fill">100</vertical>
                            </sizing>

                        </flow-layout>

                    </children>


                    <!-- No horizontal growth caused by children -->

                    <gap>0</gap>


                    <sizing>
                        <horizontal method="fill">100</horizontal>
                        <vertical method="fill">100</vertical>
                    </sizing>

                </flow-layout>


                <!-- ================================================== -->
                <!-- BOTTOM BAR                                         -->
                <!-- ================================================== -->

                <flow-layout
                    id="bottom-bar"
                    direction="horizontal">

                    <children>

                        <!-- ========================================== -->
                        <!-- SAVE                                       -->
                        <!-- ========================================== -->

                        <button id="save">
                            <text>Save</text>
                        </button>


                        <!-- ========================================== -->
                        <!-- CLEAR                                      -->
                        <!-- ========================================== -->

                        <button id="reset">
                            <text>Clear</text>
                        </button>


                        <!-- ========================================== -->
                        <!-- CANCEL                                     -->
                        <!-- ========================================== -->

                        <button id="cancel">
                            <text>Cancel</text>
                        </button>

                    </children>


                    <gap>8</gap>


                    <!-- Bottom-left alignment -->

                    <padding>
                        <top>8</top>
                        <bottom>14</bottom>
                        <left>16</left>
                        <right>16</right>
                    </padding>


                    <horizontal-alignment>left</horizontal-alignment>


                    <sizing>
                        <horizontal method="fill">100</horizontal>
                        <vertical method="content"/>
                    </sizing>

                </flow-layout>

            </children>


            <!-- ====================================================== -->
            <!-- ROOT SIZING                                            -->
            <!-- ====================================================== -->

            <sizing>
                <horizontal method="fill">100</horizontal>
                <vertical method="fill">100</vertical>
            </sizing>


            <!-- ====================================================== -->
            <!-- ROOT BACKGROUND                                        -->
            <!-- ====================================================== -->

            <surface>
                <vanilla-translucent/>
            </surface>

        </flow-layout>

    </components>

</owo-ui>
