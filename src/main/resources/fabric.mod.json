{
	"schemaVersion": 1,
	"id": "puppyutils",
	"version": "${version}",
	"name": "puppyutils",
	"description": "A QoL mod for hypixel skyblock automation :3",
	"authors": [
		"Some silly puppygirl ;3"
	],
	"license": "CC0-1.0",
	"icon": "assets/puppyutils/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"de.puppyutils.Puppyutils"
		],
		"client": [
			"de.puppyutils.client.PuppyutilsClient"
		]
	},
	"mixins": [
		"puppyutils.mixins.json",
		{
			"config": "puppyutils.client.mixins.json",
			"environment": "client"
		}
	],
	"accessWidener": "puppyutils.client.accesswidener",
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
